:root {
    --bg-color: #ffffff;
    --text-color: #1d1d1f;
    --secondary-text: #86868b;
    --link-color: #0066cc;
}

@media (prefers-color-scheme: dark) {
    :root {
        --bg-color: #000000;
        --text-color: #f5f5f7;
        --secondary-text: #86868b;
        --link-color: #2997ff;
    }
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.47059;
    letter-spacing: -0.022em;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
}

.container {
    max-width: 680px;
    margin: 0 auto;
    padding: 80px 20px;
}

h1 {
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 8px;
    margin-top: 0;
}

h2 {
    font-size: 24px;
    font-weight: 600;
    margin-top: 40px;
    margin-bottom: 16px;
}

p {
    font-size: 17px;
    margin-bottom: 20px;
}

.subtitle {
    color: var(--secondary-text);
    font-size: 24px;
    font-weight: 500;
    margin-bottom: 40px;
}

.date { 
    color: var(--secondary-text);
    font-size: 17px; 
    margin-bottom: 40px;
}

a {
    color: var(--link-color);
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

nav {
    display: flex;
    gap: 24px;
    margin-top: 40px;
}

nav a {
    font-size: 17px;
    font-weight: 500;
}

.back-link {
    display: inline-block;
    margin-bottom: 40px;
    font-size: 17px;
}

.contact {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--secondary-text);
}

/* Переключатель языков */
.lang-switcher {
    text-align: right;
    margin-bottom: 30px;
    font-size: 15px;
    font-weight: 600;
}

.lang-switcher a {
    color: var(--secondary-text);
    padding: 0 4px;
}

.lang-switcher a.active {
    color: var(--text-color);
    pointer-events: none;
}
